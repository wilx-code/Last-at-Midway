FJ)+F4s9P!Ft_szwY-/8">pitch</field></block></value></block></value><next><block type="typescript_statement" id="e^2nNgXKo4*n$b;zL6zo"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="for (let j = smokeAge.length - 1; j &gt;= 0; j--) {" line1="        smokeAge[j] += 1" line2="        smokeZ[j] += gunnerSpeed / 200 * cloudTravelSpeed" line3="        smokeY[j] -= 0.5" line4="        if (smokeAge[j] &gt; 75) {" line5="            smokeX.removeAt(j)" line6="            smokeY.removeAt(j)" line7="            smokeZ.removeAt(j)" line8="            smokeAge.removeAt(j)" line9="        } else {" line10="            let rx = smokeX[j] * cyaw - smokeZ[j] * syaw" line11="            let rz = smokeX[j] * syaw + smokeZ[j] * cyaw" line12="            let ry = smokeY[j] * cpitch - rz * spitch" line13="            let depth = smokeY[j] * spitch + rz * cpitch" line14="            if (depth &gt; 100) {" line15="                let x = 120 + rx * focalLength / depth" line16="                let y = 90 + ry * focalLength / depth + tilt * (x - 120) / 120" line17="                let r = Math.max(1, Math.min(9, Math.round((18 + smokeAge[j] * 0.8) * focalLength / depth)))" line18="                let d = 3" line19="                if (smokeAge[j] &gt; 25) d = 10" line20="                if (smokeAge[j] &gt; 50) d = 12" line21="                if (x &gt; -10 &amp;&amp; x &lt; 250 &amp;&amp; y &gt; -10 &amp;&amp; y &lt; 190) {" line22="                    terrain.fillCircle(Math.round(x), Math.round(y), r, d)" line23="                }" line24="            }" line25="        }" line26="    }" numlines="27"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="uIgCWgdhqa5}Bmp!#B:[" x="20" y="13013"><mutation name="renderEnemies" functionid="o+pn14@n1s/P]dw3Fo%X"></mutation><field name="function_name">renderEnemies</field><statement name="STACK"><block type="variables_set" id="