tiveYaw) * focalLength +" line31="                bulletX[i] * trailPerspective" line32="" line33="            let trailY = 90 +" line34="                Math.tan(relativePitch) * focalLength +" line35="                bulletY[i] * trailPerspective" line36="" line37="            by += tilt * (bx - 120) / 120" line38="            trailY += tilt * (trailX - 120) / 120" line39="" line40="            if (" line41="                bx &gt;= 0 &amp;&amp; bx &lt; 240 &amp;&amp;" line42="                by &gt;= 0 &amp;&amp; by &lt; 180" line43="            ) {" line44="" line45="                terrain.drawLine(" line46="                    Math.round(trailX)," line47="                    Math.round(trailY)," line48="                    Math.round(bx)," line49="                    Math.round(by)," line50="                    4" line51="                )" line52="" line53="                terrain.fillRect(" line54="                    Math.round(bx)," line55="                    Math.round(by)," line56="                    2, 2, 5" line57="                )" line58="            }" line59="        }" line60="" line61="        if (bulletDepth[i] &gt; 5) {" line62="" line63="            bulletX.removeAt(i)" line64="            bulletY.removeAt(i)" line65="            bulletDepth.removeAt(i)" line66="            bulletYaw.removeAt(i)" line67="            bulletPitch.removeAt(i)" line68="        }" line69="    }" numlines="70"></mutation></block></statement></block><block type="function_definition" id="z5tT+Wqm{u$!LLYX(o]t" x="13365" y="20"><mutation name="getHorizon" functionid="KZw{EQFh$9?qka*RYLv$"><arg name="screenPositionX" id="l137pv9bwkn877ag5gz3" type="number"></arg></mutation><field name="function_name">getHorizon</field><value name="l137pv9bwkn877ag5gz3"><block type="argument_reporter_number" id="+wnjhlUq_PpE^NyRx)i:" deletable="false"><field name="VALUE">screenPositionX</field></block></value><statement name="STACK"><block type="function_return" id="_ZCe,qU8F^!:h_,N+P-