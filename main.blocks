0"><block type="function_return" id="R$9]Y}T7EWg1ynyZqG?_"><mutation xmlns="http://www.w3.org/1999/xhtml" no_return_value="true"></mutation></block></statement><next><block type="typescript_statement" id="NoSN}2QftM]gS0T0KgtN"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="for (let smokeIndex = 39; smokeIndex &gt;= 0; smokeIndex--) {" line1="" line2="        let smokeAge2 =" line3="            (explosionTime - smokeIndex * 4) % 160" line4="" line5="        if (smokeAge2 &gt; 0) {" line6="" line7="            let rise = smokeAge2 * 5" line8="" line9="            let drift = rise * 0.18" line10="" line11="            let turbulence = Math.sin(" line12="                smokeAge2 * 0.09" line13="            ) * (8 + rise * 0.06)" line14="" line15="            let smokeX2 = carrierX +" line16="                drift + turbulence" line17="" line18="            let smokeY2 = carrierY - 25 - rise" line19="" line20="            let smokePoint = projectMissionPoint(" line21="                smokeX2," line22="                smokeY2," line23="                carrierZ" line24="            )" line25="" line26="            if (smokePoint.length &gt; 0) {" line27="" line28="                let sx4 = Math.round(smokePoint[0])" line29="                let sy4 = Math.round(smokePoint[1])" line30="" line31="                let smokeScale =" line32="                    focalLength / smokePoint[2]" line33="" line34="                let smokeRadius = Math.max(" line35="                    1," line36="                    Math.min(" line37="                        22," line38="                        (12 + rise * 0.09) * smokeScale" line39="                    )" line40="                )" line41="" line42="                let smokeColor = 3" line43="" line44="                if (smokeAge2 &gt; 50) {" line45="                    smokeColor = 10" line46="                }" line47="" line48="                if (smokeAge2 &gt; 110) {" line49="                    smokeColor = 12" line50="                }" line51="" line52="                terrain.fillCircle(" line53="                    sx4, sy4," line54="                    Math.max(1, Math.round(smokeRadius))," line55="                    smokeColor" line56="                )" line57="" line58="                terrain.fillCircle(" line59="                    Math.round(sx4 - smokeRadius * 0.7)," line60="                    Math.round(sy4 - smokeRadius * 0.4)," line61="                    Math.max(1, Math.round(smokeRadius * 0.65))," line62="                    smokeColor" line63="                )" line64="" line65="                terrain.fillCircle(" line66="                    Math.round(sx4 + smokeRadius * 0.6)," line67="                    Math.round(sy4 + smokeRadius * 0.3)," line68="                    Math.max(1, Math.round(smokeRadius * 0.55))," line69="                    smokeColor" line70="                )" line71="            }" line72="        }" line73="    }" numlines="74"></mutation><next><block type="variables_set" id="*XQ|=FI2%F[4+RQc+W.+"><field name="VAR" id="|,L=}Dw^tmpvkyR[`ZF5">firePoint</field><value name="VALUE"><shadow type="math_number" id="-$gVD;:oyC}SvUhn|L-1"><field name="NUM">0</field></shadow><block type="function_call_output" id="#$0%v(WH{!w#N]`a36Q%"><mutation name="projectMissionPoint" functionid="4X{ui.l2;^o1`+LXeTIi"><arg name="worldX" id="21rg5bids3xpmwfl3bzc1" type="number"></arg><arg name="worldY" id="7gd1q3qwvisgczcuvjvp" type="number"></arg><arg name="worldZ" id="ty8if0ukmq0ys2awtlli" type="number"></arg></mutation><value name="21rg5bids3xpmwfl3bzc1"><shadow type="math_number" id="3#|/HmM?D1^!|]liXXT,"><field name="NUM">1</field></shadow><block type="variables_get" id="!%pP5[}d3sVA#iDRh|K#"><field name="VAR" id="0Fjvxxi1%dBFtwH98V`*">carrierX</field></block></value><value name="7gd1q3qwvisgczcuvjvp"><shadow type="math_number" id="O9)6ewdjo+GD(AHbR0-P"><field name="NUM">1</field></shadow><block type="math_arithmetic" id="voED!WA1@#TtcXH33K6E"><field nam